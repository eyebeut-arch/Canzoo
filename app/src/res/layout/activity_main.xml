<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="16dp" android:background="@color/bg"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="Canzoo" android:textColor="@color/text" android:textStyle="bold"
  android:textSize="30sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:text="Ton assistant personnel • Offline First" android:textColor="@color/muted"
  android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Spinner android:id="@+id/languageSpinner" android:layout_marginTop="10dp"
  android:layout_width="match_parent" android:layout_height="48dp"/>
 <ScrollView android:id="@+id/chatScroll" android:layout_marginTop="8dp"
  android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/chatContainer" android:orientation="vertical"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </ScrollView>
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
  android:layout_width="match_parent" android:layout_height="wrap_content">
  <EditText android:id="@+id/messageInput" android:hint="Écris à Canzoo…"
   android:textColor="@color/text" android:hintTextColor="@color/muted"
   android:backgroundTint="@color/accent" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="56dp"/>
  <ImageButton android:id="@+id/micButton" android:src="@android:drawable/ic_btn_speak_now"
   android:contentDescription="Parler" android:backgroundTint="@color/card"
   android:layout_width="52dp" android:layout_height="52dp"/>
  <Button android:id="@+id/sendButton" android:text="➤" android:layout_width="52dp" android:layout_height="52dp"/>
 </LinearLayout>
</LinearLayout>
